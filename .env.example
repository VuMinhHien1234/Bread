# Database (Neon, bản pooled)
DATABASE_URL=

# Better Auth — BETTER_AUTH_SECRET phải >= 32 ký tự ngẫu nhiên
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=banh-mi-thanh-long-dev

# Telegram (chat_id của nhóm là số âm)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# P1: dùng cho webhook nút bấm trên tin Telegram
TELEGRAM_WEBHOOK_SECRET=

# Băm IP chống spam — chuỗi ngẫu nhiên >= 16 ký tự
IP_HASH_SALT=

# Công khai (an toàn để lộ ra trình duyệt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
