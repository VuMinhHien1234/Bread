{
  "name": "banh-mi-thanh-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env scripts/admin-create.ts",
    "telegram:test": "tsx --conditions=react-server --env-file-if-exists=.env scripts/telegram-test.ts",
    "telegram:chat-id": "tsx --conditions=react-server --env-file-if-exists=.env scripts/telegram-chat-id.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-seed.ts",
    "db:clear": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-clear.ts",
    "db:backup": "bash scripts/db-backup.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "1.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
